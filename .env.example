# Copy to .env.local for local development (never commit secrets)

# Web3Forms access key (optional — fallback exists in code for build)
VITE_WEB3FORMS_KEY=your_web3forms_key

# Cloudflare Worker chat API URL (after deploying worker)
VITE_CHAT_API_URL=https://meeth-portfolio-chat.YOUR_SUBDOMAIN.workers.dev
